          },
          "editorMode": "code",
          "expr": "sum by (token_type) (increase(llm_tokens_consumed_total{client_id=~\"$client_id\"}[$__range]))",
          "refId": "A",
          "range": true,
          "legendFormat": "{{token_type}}"
