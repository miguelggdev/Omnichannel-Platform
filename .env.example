# =============================================================================
# .env.example — Variables de Entorno
# Plataforma SaaS Omnicanal Multi-Tenant de IA Conversacional
# =============================================================================
# Copiar a .env y rellenar con valores reales.
# NUNCA commitear .env al repositorio.
# =============================================================================

# ─── PostgreSQL (Supabase self-hosted) ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=omnichannel
POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── pgBouncer ───────────────────────────────────────────────────────────────
# La app se conecta via pgBouncer, NO directo a PostgreSQL.
# pgBouncer DEBE estar en transaction mode para compatibilidad con SET LOCAL.
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432
PGBOUNCER_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGBOUNCER_HOST}:${PGBOUNCER_PORT}/${POSTGRES_DB}

# ─── Redis ───────────────────────────────────────────────────────────────────
# DB 0: Celery broker | DB 1: Celery results | DB 2: App cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── Cifrado (pgcrypto) ─────────────────────────────────────────────────────
# Clave simetrica para cifrar columnas sensibles (telefonos, emails, datos medicos).
ENCRYPTION_KEY=your_encryption_key_min_32_chars_here

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ─── Anthropic (Admin Assistant — Sprint 3+) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ADMIN_ASSISTANT_MODEL=claude-sonnet-4-20250514
ADMIN_ASSISTANT_MAX_TOKENS=4096
ADMIN_ASSISTANT_RATE_LIMIT=30

# ─── YCloud (WhatsApp Business API — Sprint 4) ──────────────────────────────
YCLOUD_API_KEY=your_ycloud_api_key_here
YCLOUD_WEBHOOK_SECRET=your_ycloud_webhook_secret_here
YCLOUD_BASE_URL=https://api.ycloud.com/v2

# ─── Meta Graph API (Instagram DM + Facebook Messenger — Sprint 4) ──────────
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_VERIFY_TOKEN=your_meta_verify_token_here
META_GRAPH_API_VERSION=v19.0

# ─── Supabase (self-hosted) ─────────────────────────────────────────────────
SUPABASE_URL=http://supabase-auth:9999
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=${JWT_SECRET}
SITE_URL=http://localhost:3000

# ─── Supabase Realtime ──────────────────────────────────────────────────────
REALTIME_SECRET_KEY_BASE=your_secret_key_base_min_64_chars_here

# ─── Supabase Storage ───────────────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_BUCKET=documents

# ─── Traefik ─────────────────────────────────────────────────────────────────
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=your_traefik_password_here
DOMAIN=localhost

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_WEBHOOK_CONCURRENCY=4
CELERY_AI_CONCURRENCY=2
CELERY_DOCUMENTS_CONCURRENCY=2
CELERY_NOTIFICATIONS_CONCURRENCY=2
CELERY_BULK_CONCURRENCY=1

# ─── Observabilidad ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=omnichannel-api
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Grafana ─────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here
GF_SERVER_ROOT_URL=http://localhost:3000

# ─── Google Calendar (Sprint 7) ─────────────────────────────────────────────
# GOOGLE_CALENDAR_CREDENTIALS_JSON=  # Base64-encoded service account JSON
# GOOGLE_CALENDAR_ID=primary

# ─── Super Admin Telegram Bot (Sprint 8) ────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# ─── Telegram Canal (Sprint 9) ─────────────────────────────────────────────
# TELEGRAM_CHANNEL_BOT_TOKEN=your_telegram_channel_bot_token_here

# ─── Twilio / Vonage — Voz (Sprint 13) ──────────────────────────────────────
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ─── App Settings ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
