# =============================================================================
# .env.example — Variables de Entorno
# Plataforma SaaS Omnicanal Multi-Tenant de IA Conversacional
# =============================================================================
# Copiar a .env y rellenar con valores reales.
# NUNCA commitear .env al repositorio.
# =============================================================================

# ─── Supabase Cloud — Proyecto ───────────────────────────────────────────────
# Obtener en: Dashboard del proyecto → Connect
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_REGION=us-east-1
SUPABASE_URL=https://${SUPABASE_PROJECT_REF}.supabase.co

# ─── PostgreSQL (Supabase Cloud, vía Supavisor) ──────────────────────────────
# La app SIEMPRE se conecta por el Transaction Pooler (puerto 6543), NUNCA directo.
# Igual que antes con pgBouncer self-hosted: transaction mode compatible con SET LOCAL.
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your_supabase_db_password_here
DATABASE_URL=postgresql+asyncpg://postgres.${SUPABASE_PROJECT_REF}:${POSTGRES_PASSWORD}@aws-0-${SUPABASE_REGION}.pooler.supabase.com:6543/${POSTGRES_DB}

# Direct connection — SOLO para migraciones de Alembic (no soporta pooling de transacciones).
# Requiere IPv6 o el add-on de IPv4 del proyecto.
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db.${SUPABASE_PROJECT_REF}.supabase.co:5432/${POSTGRES_DB}

# ─── Redis ───────────────────────────────────────────────────────────────────
# Supabase no provee Redis: sigue siendo un servicio aparte (contenedor propio o
# un proveedor como Upstash/Redis Cloud). No cambia con la migración a Cloud.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# Obtener en: Dashboard del proyecto → Project Settings → API → JWT Settings
# (antes se generaba a mano para el GoTrue self-hosted; ahora Supabase lo gestiona)
JWT_SECRET=your_supabase_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ─── Cifrado (pgcrypto) ─────────────────────────────────────────────────────
# Clave simétrica para cifrar columnas sensibles (teléfonos, emails, datos médicos).
ENCRYPTION_KEY=your_encryption_key_min_32_chars_here

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ─── YCloud (WhatsApp Business API) ─────────────────────────────────────────
YCLOUD_API_KEY=your_ycloud_api_key_here
YCLOUD_WEBHOOK_SECRET=your_ycloud_webhook_secret_here
YCLOUD_BASE_URL=https://api.ycloud.com/v2

# ─── Supabase API Keys ───────────────────────────────────────────────────────
# Obtener en: Dashboard del proyecto → Project Settings → API Keys
# Formato nuevo (recomendado — el legacy anon/service_role se deprecará a fines de 2026)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Legacy JWT keys — dejar comentadas salvo que el proyecto aún no tenga las nuevas
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Supabase Storage (S3-compatible, Cloud) ────────────────────────────────
# Obtener en: Dashboard del proyecto → Storage → S3 Configuration → Access keys
STORAGE_BACKEND=s3
S3_ENDPOINT=https://${SUPABASE_PROJECT_REF}.storage.supabase.co/storage/v1/s3
S3_REGION=${SUPABASE_REGION}
S3_ACCESS_KEY=your_supabase_s3_access_key_here
S3_SECRET_KEY=your_supabase_s3_secret_key_here
S3_BUCKET=documents

# ─── Traefik ─────────────────────────────────────────────────────────────────
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=your_traefik_password_here
DOMAIN=localhost

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_WEBHOOK_CONCURRENCY=4
CELERY_AI_CONCURRENCY=2
CELERY_DOCUMENTS_CONCURRENCY=2
CELERY_NOTIFICATIONS_CONCURRENCY=2
CELERY_BULK_CONCURRENCY=1

# ─── Observabilidad ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=omnichannel-api
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Grafana ─────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here
GF_SERVER_ROOT_URL=http://localhost:3000

# ─── Google Calendar (Sprint 7) ─────────────────────────────────────────────
# GOOGLE_CALENDAR_CREDENTIALS_JSON=  # Base64-encoded service account JSON
# GOOGLE_CALENDAR_ID=primary

# ─── Telegram (Sprint 9) ────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Meta / Instagram (Sprint 9) ────────────────────────────────────────────
# META_APP_SECRET=your_meta_app_secret_here
# META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
# META_VERIFY_TOKEN=your_meta_verify_token_here

# ─── Twilio / Vonage — Voz (Sprint 13) ──────────────────────────────────────
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ─── App Settings ───────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
