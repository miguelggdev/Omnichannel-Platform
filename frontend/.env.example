# URL publica del backend (la usa el navegador solo si no pasa por el rewrite de /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL del backend vista desde el contenedor del frontend (red de Docker). Si falta, usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Idioma por defecto de la interfaz: es, en, pt, it, de, fr
NEXT_PUBLIC_DEFAULT_LOCALE=es
